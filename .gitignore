# ===== Maven / Java 构建产物 =====
target/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# ===== 运行期输出目录 =====
# runner 默认把产物写到 <cwd>/log/。此处必须锚定为 "/log/"，
# 切勿改成未锚定的 "log/"，否则会递归匹配并误忽略源码包
# ecbench-app/src/main/java/io/github/ecommercebench/app/log/。
/log/

# ===== 本地密钥 =====
# 服务启动时读取的 LLM 密钥文件（真实环境变量优先，本文件只填补缺失项），绝不入库。
.env

# ===== IDE / 操作系统 =====
.idea/
*.iml
.vscode/
.superpowers/
.qoder/
.DS_Store
Thumbs.db
